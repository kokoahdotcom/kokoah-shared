{
  "name": "@kokoah/shared",
  "version": "0.1.3",
  "private": true,
  "description": "Shared TypeScript library for Kokoah: Hyperliquid adapter, markets, precision, risk, intents, action compiler, signing, policy, errors and guardians.",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./network": {
      "types": "./dist/network/index.d.ts",
      "import": "./dist/network/index.js",
      "default": "./dist/network/index.js"
    },
    "./markets": {
      "types": "./dist/markets/index.d.ts",
      "import": "./dist/markets/index.js",
      "default": "./dist/markets/index.js"
    },
    "./precision": {
      "types": "./dist/precision/index.d.ts",
      "import": "./dist/precision/index.js",
      "default": "./dist/precision/index.js"
    },
    "./risk": {
      "types": "./dist/risk/index.d.ts",
      "import": "./dist/risk/index.js",
      "default": "./dist/risk/index.js"
    },
    "./intents": {
      "types": "./dist/intents/index.d.ts",
      "import": "./dist/intents/index.js",
      "default": "./dist/intents/index.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "import": "./dist/actions/index.js",
      "default": "./dist/actions/index.js"
    },
    "./signing": {
      "types": "./dist/signing/index.d.ts",
      "import": "./dist/signing/index.js",
      "default": "./dist/signing/index.js"
    },
    "./policy": {
      "types": "./dist/policy/index.d.ts",
      "import": "./dist/policy/index.js",
      "default": "./dist/policy/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "import": "./dist/errors/index.js",
      "default": "./dist/errors/index.js"
    },
    "./guardians": {
      "types": "./dist/guardians/index.d.ts",
      "import": "./dist/guardians/index.js",
      "default": "./dist/guardians/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spikes.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spikes.json --noEmit && vitest run && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@nktkas/hyperliquid": "0.33.3",
    "valibot": "1.5.0",
    "viem": "2.56.8"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
